# Python reads process environment variables; this file is a reference, not auto-loaded.
# python run.py supplies the local simulator address and key to the backend.
# For manual startup, these server-side settings can be set in your terminal:
DESK_API_BASE_URL=http://127.0.0.1:8000
DESK_API_KEY=YOUR_SIMULATOR_KEY

# The backend history collector and CLI save commands use PostgreSQL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/group7_desksystem

# The backend waits this many seconds between history saves.
DESK_HISTORY_INTERVAL_SECONDS=60

# Group movements (S5-1). Defaults are shown; the countdown can be lowered for demos.
# GROUP_WARNING_COUNTDOWN_SECONDS=10
# GROUP_WARNING_ACK_TIMEOUT_SECONDS=15
# GROUP_WARNING_STALE_SECONDS=15
# GROUP_WARNING_REQUIRED_CHANNELS=pico,dashboard
# GROUP_MONITOR_TIMEOUT_SECONDS=60
# GROUP_MONITOR_POLL_SECONDS=1
