# Python reads process environment variables; this file is a reference, not auto-loaded.
# python run.py supplies the local simulator address and key to the backend.
# For manual startup, these server-side settings can be set in your terminal:
DESK_API_BASE_URL=http://127.0.0.1:8000
DESK_API_KEY=YOUR_SIMULATOR_KEY

# Only the CLI sync and move commands need PostgreSQL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@127.0.0.1:5432/group7_desksystem
